NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_MAX_DONATION_AMOUNT=5000
NEXT_PUBLIC_ALLOW_SIMULATED_DONATIONS=false
# Verifier enrollment uses the private backend VERIFIER_KEY during account creation.
# The API verifies the PayPal capture status before this UI reports a completed donation.

# Optional sandbox-only test action; match the backend setting.
NEXT_PUBLIC_ENABLE_VERIFIER_TEST_OVERRIDE=false
