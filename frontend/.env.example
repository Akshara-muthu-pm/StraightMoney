NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_MAX_DONATION_AMOUNT=5000
NEXT_PUBLIC_ALLOW_SIMULATED_DONATIONS=false
# The verifier key is entered on /verifier and stays in sessionStorage; never set it as NEXT_PUBLIC_.
# The API verifies the PayPal capture status before this UI reports a completed donation.

# Temporary sandbox test override; set false when removed.
NEXT_PUBLIC_ENABLE_VERIFIER_TEST_OVERRIDE=true
