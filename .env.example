# PayPal Sandbox credentials (get from developer.paypal.com)
PAYPAL_CLIENT_ID=your-client-id-here
PAYPAL_CLIENT_SECRET=your-client-secret-here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Donation safeguards
MAX_DONATION_AMOUNT=5000
ALLOW_SIMULATED_DONATIONS=false
# Decisions require a signed-in verifier account.
# Required to create verifier accounts. Set a private, randomly generated key.
VERIFIER_KEY=
# Private setup key used once to claim the seeded or other legacy campaign.
ADMIN_SETUP_KEY=
# PayPal webhook ID from the app's webhook configuration. Configure its URL as
# https://YOUR-API/webhooks/paypal and subscribe to capture, refund, dispute,
# and payout item events.
PAYPAL_WEBHOOK_ID=
# Capture verification uses the Orders v2 payment capture status; no extra API key or switch is required.

# LLM provider (Google Gemini)
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-1.5-pro

# App settings
SUPPORTED_CURRENCY=USD
POSTGRES_USER=straightmoney
POSTGRES_PASSWORD=change-me
POSTGRES_DB=straightmoney
DATABASE_URL=postgresql+psycopg://straightmoney:change-me@localhost:5432/straightmoney
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS - frontend dev server (Next.js default: 3000)
FRONTEND_URL=http://localhost:3000

# Used once if the primary Gemini model times out or is overloaded.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional sandbox-only test action that bypasses policy checks.

# Upload and public-demo abuse limits (per process and source IP).
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20
WRITE_RATE_LIMIT=30
# Set to a positive value to enforce a per-organizer cap.
MAX_CAMPAIGNS_PER_ORGANIZER=0
